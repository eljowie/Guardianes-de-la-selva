<!doctype html>
<html lang="{{ sitio.idioma }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ sitio.titulo }}</title>
  <meta name="description" content="{{ descripcion or sitio.subtitulo }}">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <link rel="icon" href="/iconos/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/fuentes-tipograficas/atkinson-hyperlegible-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/estilos/sitio.css">
  <link rel="stylesheet" href="/estilos/impresion.css" media="print">
</head>
<body{% if clase %} class="{{ clase }}"{% endif %}>
  <a class="saltar" href="#contenido">Saltar al contenido</a>
  {% include "partes/menu.njk" %}
  <main id="contenido" tabindex="-1">
    {{ content | safe }}
  </main>
  {% include "partes/pie.njk" %}
  <script src="/js/glosario.js" defer></script>
  <script src="/js/ver-mas.js" defer></script>
</body>
</html>
