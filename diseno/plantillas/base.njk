<!doctype html>
<html lang="{{ sitio.idioma }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ sitio.titulo }}</title>
  <meta name="description" content="{{ descripcion or sitio.subtitulo }}">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <link rel="stylesheet" href="/estilos/sitio.css">
  <link rel="stylesheet" href="/estilos/impresion.css" media="print">
</head>
<body>
  <a class="saltar" href="#contenido">Saltar al contenido</a>
  {% include "partes/menu.njk" %}
  <main id="contenido" tabindex="-1">
    {{ content | safe }}
  </main>
  {% include "partes/pie.njk" %}
</body>
</html>
