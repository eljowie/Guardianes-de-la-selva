<header class="cabecera">
  <div class="cabecera__interior">
    <a class="marca" href="/">
      <svg class="marca__icono" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="15" fill="#f3e6c4"/><path d="M16 26 C9 22 8 13 16 6 C24 13 23 22 16 26Z" fill="#4a6b2e"/><path d="M16 9 V25" stroke="#2d3b1e" stroke-width="1.6"/></svg>
      {{ sitio.titulo }}
    </a>
    <nav aria-label="Principal">
      <ul class="menu">
        {%- for item in sitio.menu %}{% if item.lista %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{% if item.mision %}{% set n = item.mision %}<span class="menu__icono">{% include "partes/icono-mision.njk" %}</span>{% endif %}{{ item.texto }}</a></li>
        {%- endif %}{% endfor %}
      </ul>
    </nav>
  </div>
</header>
